# Copiar a .env solo para despliegues que requieran autenticación.
# Modo local predeterminado: ESCANEO3D_AUTH_REQUIRED=0
ESCANEO3D_AUTH_REQUIRED=0

# Para modo remoto, cambiar a 1 y completar todos los valores.
# El secreto debe ser aleatorio, de al menos 32 bytes, y compartido
# de forma segura con el emisor de JWT HS256. No versionar el .env real.
ESCANEO3D_JWT_SECRET=
ESCANEO3D_JWT_ISSUER=
ESCANEO3D_JWT_AUDIENCE=
