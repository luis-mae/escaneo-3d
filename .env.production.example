# Copiar a .env.production en el servidor privado; NO subir secretos reales.
# Generar secreto: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ESCANEO3D_JWT_SECRET=REEMPLAZAR_POR_SECRETO_ALEATORIO_DE_48_BYTES_O_MAS
ESCANEO3D_JWT_ISSUER=escaneo3d-identidad
ESCANEO3D_JWT_AUDIENCE=escaneo3d-api
# Usuario privado para la primera beta.
ESCANEO3D_MVP_USER=operador
# Generar hash PBKDF2 (no usar una contraseña débil):
# python3 -c 'import os,hashlib; from getpass import getpass; s=os.urandom(16); print("pbkdf2_sha256$600000$"+s.hex()+"$"+hashlib.pbkdf2_hmac("sha256",getpass("Clave: ").encode(),s,600000).hex())'
ESCANEO3D_MVP_PASSWORD_HASH=REEMPLAZAR_CON_HASH_PBKDF2
# La API emite tokens JWT HS256 de una hora después de verificar la contraseña.
