# Copiar a .env.production en el servidor privado; NO subir secretos reales.
# Generar secreto: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ESCANEO3D_JWT_SECRET=REEMPLAZAR_POR_SECRETO_ALEATORIO_DE_48_BYTES_O_MAS
ESCANEO3D_JWT_ISSUER=escaneo3d-identidad
ESCANEO3D_JWT_AUDIENCE=escaneo3d-api
# Debe coincidir con un emisor JWT HS256 confiable. No habilita login por sí solo.
